{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeedResponse",
  "type": "object",
  "required": ["items", "next_cursor"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "state", "headline", "t_last", "published_at", "cover_image_url"],
        "properties": {
          "event_id": { "type": "string" },
          "state": { "type": "string", "enum": ["DETECTED", "PENDING_PUBLISH", "PUBLISHED", "UPDATING", "DORMANT", "CLOSED"] },
          "headline": { "type": ["string", "null"] },
          "t_last": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"] },
          "cover_image_url": { "type": ["string", "null"] },
          "ai_overview": {},
          "overview_status": { "type": "string", "enum": ["ready", "unavailable", "pending", "failed"] },
          "overview_mode": { "type": ["string", "null"] },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source_id", "name", "domain", "article_count"],
              "properties": {
                "source_id": { "type": "string" },
                "name": { "type": "string" },
                "domain": { "type": "string" },
                "article_count": { "type": "integer" }
              }
            }
          },
          "article_count": { "type": "integer" },
          "unique_sources_count": { "type": "integer" },
          "usable_articles_count": { "type": "integer" },
          "total_usable_text_len": { "type": "integer" },
          "key_facts_count": { "type": "integer" },
          "evidence_level": { "type": "string", "enum": ["high", "medium", "low", "none"] },
          "why_no_overview": { "type": ["string", "null"] }
        }
      }
    },
    "next_cursor": { "type": ["string", "null"] },
    "empty_reason": { "type": "string", "enum": ["NO_EVENTS", "NO_PUBLISHED", "GATE_FILTERED_ALL", "DB_EMPTY"] }
  },
  "additionalProperties": false
}
