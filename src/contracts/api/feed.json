{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FeedResponse",
  "type": "object",
  "required": ["items", "next_cursor"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "state", "headline", "t_last", "published_at", "cover_image_url"],
        "properties": {
          "event_id": { "type": "string" },
          "state": { "type": "string", "enum": ["DETECTED", "PENDING_PUBLISH", "PUBLISHED", "UPDATING", "DORMANT", "CLOSED"] },
          "headline": { "type": ["string", "null"] },
          "t_last": { "type": ["string", "null"] },
          "published_at": { "type": ["string", "null"] },
          "cover_image_url": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "next_cursor": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
