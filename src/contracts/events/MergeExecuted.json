{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MergeExecuted",
  "type": "object",
  "required": ["event_name", "event_id", "occurred_at", "trace", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_name": {
      "type": "string",
      "const": "MergeExecuted"
    },
    "event_id": {
      "type": "string",
      "description": "ULID identifier for this event"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the event occurred"
    },
    "trace": {
      "type": "object",
      "required": ["trace_id", "span_id", "source_module"],
      "additionalProperties": false,
      "properties": {
        "trace_id": {
          "type": "string"
        },
        "span_id": {
          "type": "string"
        },
        "source_module": {
          "type": "string"
        }
      }
    },
    "payload": {
      "type": "object",
      "required": ["from_event_id", "to_event_id", "canonical_event_id"],
      "additionalProperties": false,
      "properties": {
        "from_event_id": {
          "type": "string"
        },
        "to_event_id": {
          "type": "string"
        },
        "canonical_event_id": {
          "type": "string"
        }
      }
    }
  }
}
