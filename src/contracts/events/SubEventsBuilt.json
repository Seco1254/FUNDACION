{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubEventsBuilt",
  "type": "object",
  "required": ["event_name", "event_id", "occurred_at", "trace", "payload"],
  "additionalProperties": false,
  "properties": {
    "event_name": { "const": "SubEventsBuilt" },
    "event_id": { "type": "string" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "trace": {
      "type": "object",
      "required": ["trace_id", "span_id", "source_module"],
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string" },
        "span_id": { "type": "string" },
        "source_module": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["event_id", "version_id", "subevent_count"],
      "additionalProperties": false,
      "properties": {
        "event_id": { "type": "string" },
        "version_id": { "type": "string" },
        "subevent_count": { "type": "integer" }
      }
    }
  }
}
