generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Media {
  id          String    @id @default(uuid()) @db.Uuid
  mediaKey    String    @unique @map("media_key")
  name        String
  allowlisted Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  articles    Article[]

  @@map("media")
}

enum ArticleStatus {
  DISCOVERED
  NORMALIZED
  POLICY_OK
  POLICY_BLOCKED
}

enum BlockedReason {
  NOT_ALLOWLISTED
  NOT_SPANISH
  NO_EXTRACT
  DUPLICATE_URL
  PARSE_FAIL
}

model Article {
  id            String          @id @default(uuid()) @db.Uuid
  mediaId       String          @map("media_id") @db.Uuid
  media         Media           @relation(fields: [mediaId], references: [id])
  url           String          @unique
  publishedAt   DateTime?       @map("published_at")
  title         String
  snippet       String
  textNorm             String?         @map("text_norm")
  textContentLen       Int?            @map("text_content_len")
  textContentSource    String?         @map("text_content_source")
  extractionFailReason String?         @map("extraction_fail_reason")
  paywallDetected      Boolean         @default(false) @map("paywall_detected")
  usableForOverview    Boolean         @default(false) @map("usable_for_overview")
  status               ArticleStatus   @default(DISCOVERED)
  blockedReason        BlockedReason?  @map("blocked_reason")
  contentType          String?         @map("content_type")
  contentTypeScore     Float?          @map("content_type_score")
  routingDecision      String?         @map("routing_decision")
  embeddingModel String?         @map("embedding_model")
  embeddingVec   Json?           @map("embedding_vec")
  embeddingHash  String?         @map("embedding_hash")
  createdAt     DateTime        @default(now()) @map("created_at")
  eventArticles EventArticle[]
  quotes        Quote[]

  @@map("article")
}

enum EventState {
  DETECTED
  PENDING_PUBLISH
  PUBLISHED
  UPDATING
  DORMANT
  CLOSED
}

model Event {
  id               String         @id @default(uuid()) @db.Uuid
  state            EventState     @default(DETECTED)
  t0               DateTime?
  tLast            DateTime?      @map("t_last")
  publishAt        DateTime?      @map("publish_at")
  publishedAt      DateTime?      @map("published_at")
  closedAt         DateTime?      @map("closed_at")
  canonicalEventId String?        @map("canonical_event_id") @db.Uuid
  canonicalEvent   Event?         @relation("EventCanonical", fields: [canonicalEventId], references: [id])
  mergedEvents     Event[]        @relation("EventCanonical")
  createdAt        DateTime       @default(now()) @map("created_at")
  eventArticles    EventArticle[]
  versions         EventVersion[]
  claims           Claim[]

  @@index([state])
  @@index([publishedAt(sort: Desc)])
  @@index([tLast(sort: Desc)])
  @@map("event")
}

model EventArticle {
  eventId   String   @map("event_id") @db.Uuid
  event     Event    @relation(fields: [eventId], references: [id])
  articleId String   @map("article_id") @db.Uuid
  article   Article  @relation(fields: [articleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")

  @@id([eventId, articleId])
  @@unique([eventId, articleId])
  @@index([eventId])
  @@index([articleId])
  @@map("event_article")
}

enum GateStatus {
  PASS
  FAIL
  NA
}

model EventVersion {
  id           String     @id @default(uuid()) @db.Uuid
  eventId      String     @map("event_id") @db.Uuid
  event        Event      @relation(fields: [eventId], references: [id])
  versionIndex Int        @map("version_index")
  createdAt    DateTime   @default(now()) @map("created_at")
  gateStatus   GateStatus @default(NA) @map("gate_status")
  headline     String?
  packetJson   Json       @default("{}") @map("packet_json")
  diffJson     Json       @default("{}") @map("diff_json")

  claims       Claim[]

  @@unique([eventId, versionIndex])
  @@map("event_version")
}

enum ClaimType {
  FACT
  ALLEGATION
  FORECAST
  OPINION
  QUANT
}

enum ClaimStatus {
  SUPPORTED
  DISPUTED
  INSUFFICIENT
}

model Claim {
  id         String       @id @default(uuid()) @db.Uuid
  eventId    String       @map("event_id") @db.Uuid
  event      Event        @relation(fields: [eventId], references: [id])
  versionId  String       @map("version_id") @db.Uuid
  version    EventVersion @relation(fields: [versionId], references: [id])
  claimText  String       @map("claim_text")
  claimType  ClaimType    @map("claim_type")
  status     ClaimStatus
  createdAt  DateTime     @default(now()) @map("created_at")
  quotes     Quote[]

  @@index([eventId, versionId])
  @@map("claim")
}

enum QuoteStrength {
  WEAK
  MEDIUM
  STRONG
}

enum QuoteRole {
  EVIDENCE
  ATTRIBUTION
  CONTEXT
}

model Quote {
  id         String        @id @default(uuid()) @db.Uuid
  claimId    String        @map("claim_id") @db.Uuid
  claim      Claim         @relation(fields: [claimId], references: [id])
  articleId  String        @map("article_id") @db.Uuid
  article    Article       @relation(fields: [articleId], references: [id])
  quoteText  String        @map("quote_text")
  spanStart  Int?          @map("span_start")
  spanEnd    Int?          @map("span_end")
  strength   QuoteStrength
  role       QuoteRole
  createdAt  DateTime      @default(now()) @map("created_at")

  @@index([claimId])
  @@index([articleId])
  @@map("quote")
}

enum BiasScope {
  MEDIA_LEVEL
  ARTICLE_LEVEL
}

model BiasLabel {
  id              String    @id @default(uuid()) @db.Uuid
  scope           BiasScope
  mediaId         String?   @map("media_id") @db.Uuid
  articleId       String?   @map("article_id") @db.Uuid
  eventId         String    @map("event_id") @db.Uuid
  versionId       String    @map("version_id") @db.Uuid
  labelPrimary    String    @map("label_primary")
  labelSecondary  String?   @map("label_secondary")
  intensity       Float
  confidence      Float
  rationaleJson   Json      @map("rationale_json") @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([eventId, versionId])
  @@index([mediaId, eventId])
  @@index([articleId])
  @@map("bias_label")
}

model TopicAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  versionId  String   @map("version_id") @db.Uuid
  articleId  String   @map("article_id") @db.Uuid
  topicKey   String   @map("topic_key")
  weight     Float
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([eventId, versionId])
  @@index([topicKey])
  @@index([articleId])
  @@map("topic_assignment")
}

model MediaProfile {
  mediaId     String   @id @map("media_id") @db.Uuid
  profileJson Json     @map("profile_json") @default("{}")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("media_profile")
}

enum AuditEntityType {
  ARTICLE
  EVENT
  EVENT_VERSION
  MERGE
  SUB_EVENT
  OVERVIEW
  CLAIM
  BIAS
  TOPIC
}

model AuditLog {
  id         String          @id @default(uuid()) @db.Uuid
  occurredAt DateTime        @default(now()) @map("occurred_at")
  entityType AuditEntityType @map("entity_type")
  entityId   String          @map("entity_id")
  action     String
  traceId    String          @map("trace_id")
  data       Json            @default("{}")

  @@index([entityId])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_log")
}
