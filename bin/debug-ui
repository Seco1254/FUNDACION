#!/usr/bin/env bash
# bin/debug-ui — quick diagnostic: health + feed + gate stats
# Usage: ./bin/debug-ui [BASE_URL]
# See RUNBOOK_UI_NOT_LOADING.md for the full decision tree.
set -euo pipefail

BASE="${1:-http://localhost:${PORT:-3000}}"

# ── Helper ───────────────────────────────────────────────────────
parse() {
  node -e "d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{$1})"
}

# ── 1) Health ────────────────────────────────────────────────────
echo "=== 1/3  Health ==="
HEALTH=$(curl -sf "$BASE/v1/health" 2>&1) || { echo "FAIL: backend not reachable at $BASE"; exit 1; }
echo "$HEALTH" | parse "const j=JSON.parse(d);console.log(j.ok?'PASS':'FAIL',JSON.stringify(j))"

# ── 2) Feed ──────────────────────────────────────────────────────
echo ""
echo "=== 2/3  Feed ==="
FEED=$(curl -sf "$BASE/v1/feed?tab=global" 2>&1) || { echo "FAIL: /v1/feed returned error"; exit 1; }
echo "$FEED" | parse "
  const j=JSON.parse(d);
  const items=j.items||[];
  console.log(items.length>0?'PASS':'FAIL','items='+items.length);
  const sample=items[0];
  if(sample){
    console.log('  sample:');
    console.log('    event_id:',sample.event_id);
    console.log('    headline:',sample.headline);
    console.log('    overview_status:',sample.overview_status??'(missing)');
    console.log('    evidence_level:',sample.evidence_level??'(missing)');
    console.log('    sources:',(sample.sources||[]).length);
  }
"

# ── 3) Gate diagnostics ─────────────────────────────────────────
echo ""
echo "=== 3/3  Gate Stats ==="
STATS=$(curl -sf "$BASE/v1/debug/feed/stats" 2>&1) || { echo "FAIL: /v1/debug/feed/stats returned error"; exit 1; }
echo "$STATS" | parse "
  const j=JSON.parse(d);
  const t=j.totals;
  console.log('published_total='+t.published_total,'feed_returned='+t.feed_returned_count,'gate_filtered='+t.gate_filtered_count);
  if(t.gate_filtered_count>0){
    console.log('  top filter reasons:');
    (j.top_filter_reasons||[]).forEach(r=>console.log('   ',r.reason,'('+r.count+')'));
  }
  if(j.sample_fail){
    console.log('  sample_fail: id='+j.sample_fail.event_id+' reasons='+j.sample_fail.gate_reasons.join(',')+' evidence='+j.sample_fail.evidence_level);
  }
"

echo ""
echo "Done. See RUNBOOK_UI_NOT_LOADING.md for the full decision tree."
