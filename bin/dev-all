#!/usr/bin/env bash
# bin/dev-all — start backend + Expo web client in parallel
# Usage: ./bin/dev-all
set -euo pipefail
cd "$(dirname "$0")/.."

# ── Load .env ──────────────────────────────────────────────────────
if [ ! -f .env ]; then
  echo "❌ .env not found"
  echo "   Fix: cp .env.example .env  (then edit DATABASE_URL if needed)"
  exit 1
fi

set -a
# shellcheck disable=SC1091
source .env
set +a

if [ -z "${DATABASE_URL:-}" ]; then
  echo "❌ DATABASE_URL is empty in .env"
  echo "   Fix: edit .env and set DATABASE_URL"
  exit 1
fi

# ── Fast-publish defaults (override via .env or shell) ─────────────
export PUBLISH_DELAY_MS="${PUBLISH_DELAY_MS:-0}"
export SCHEDULER_TICK_MS="${SCHEDULER_TICK_MS:-3000}"
export SCRAPE_INTERVAL_MS="${SCRAPE_INTERVAL_MS:-60000}"

# ── PIDs to clean up on exit ───────────────────────────────────────
BACKEND_PID=""
CLIENT_PID=""

cleanup() {
  echo ""
  echo "🛑 Shutting down..."
  [ -n "$BACKEND_PID" ] && kill "$BACKEND_PID" 2>/dev/null && echo "   Stopped backend (PID $BACKEND_PID)"
  [ -n "$CLIENT_PID" ] && kill "$CLIENT_PID" 2>/dev/null && echo "   Stopped client  (PID $CLIENT_PID)"
  wait 2>/dev/null
  echo "✅ All processes stopped"
}
trap cleanup EXIT INT TERM

# ── Detect free port for Expo web ──────────────────────────────────
CLIENT_PORT="${CLIENT_PORT:-8081}"
is_port_free() {
  ! (echo >/dev/tcp/127.0.0.1/"$1") 2>/dev/null
}
if ! is_port_free "$CLIENT_PORT"; then
  echo "⚠️  Port $CLIENT_PORT is busy, scanning for a free port..."
  for p in 8082 8083 8084 8085 19006; do
    if is_port_free "$p"; then
      CLIENT_PORT="$p"
      break
    fi
  done
  if ! is_port_free "$CLIENT_PORT"; then
    echo "❌ Could not find a free port for Expo web (tried 8081-8085, 19006)"
    exit 1
  fi
fi

BACKEND_PORT="${PORT:-3000}"

# ── Start backend ──────────────────────────────────────────────────
echo "🚀 Starting backend on http://localhost:$BACKEND_PORT ..."
npm run dev &
BACKEND_PID=$!

# ── Start Expo web client ──────────────────────────────────────────
echo "🚀 Starting Expo web client on http://localhost:$CLIENT_PORT ..."
(cd apps/client && npx expo start --web --port "$CLIENT_PORT") &
CLIENT_PID=$!

echo ""
echo "┌──────────────────────────────────────────┐"
echo "│  Backend:  http://localhost:$BACKEND_PORT          │"
echo "│  Client:   http://localhost:$CLIENT_PORT          │"
echo "│  Press Ctrl+C to stop both               │"
echo "└──────────────────────────────────────────┘"
echo ""

# ── Wait for either process to exit ────────────────────────────────
wait -n "$BACKEND_PID" "$CLIENT_PID" 2>/dev/null || true
