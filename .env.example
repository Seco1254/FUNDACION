# Required — set to YOUR local Postgres credentials
# Docker:   postgresql://fundacion:fundacion@localhost:5432/fundacion?schema=public
# Homebrew: postgresql://$USER@localhost:5432/fundacion?schema=public
DATABASE_URL=postgresql://fundacion:fundacion@localhost:5432/fundacion?schema=public

# Server
PORT=3000
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Cache
CACHE_MAX_ENTRIES=500
CACHE_DEFAULT_TTL_MS=30000

# Scheduler
SCHEDULER_TICK_MS=30000
SCRAPE_INTERVAL_MS=900000
PUBLISH_DELAY_MS=300000
CLOSE_CHECK_INTERVAL_MS=21600000
REFRESH_INTERVAL_MS=1800000

# Dev overrides (uncomment for faster local iteration)
# SCHEDULER_TICK_MS=5000
# PUBLISH_DELAY_MS=30000
# CLOSE_CHECK_INTERVAL_MS=60000
# REFRESH_INTERVAL_MS=60000

# Event linker thresholds (lower = more linking, fewer single-article events)
THETA_AUTO_LINK=0.45
THETA_MAYBE_LINK=0.30

# Event linker candidate window
EVENT_LINKER_CANDIDATE_WINDOW_HOURS=72
EVENT_LINKER_FALLBACK_WINDOW_DAYS=7

# Entity guard (prevents false merges when entities don't overlap)
# EVENT_LINKER_ENTITY_GUARD_ENABLED=0   # set to 0 to disable (enabled by default)
# EVENT_LINKER_ENTITY_GUARD_MIN_JACCARD=0.01

# Kill switches
# DISABLE_AUTO_LINK=1       # never auto-link, only maybe/create

# Debug / instrumentation (set to 1 for verbose linker decision logs)
# DEBUG_EVENT_LINKER=1

# Event linker v2.1 — hard negative gates (block auto-link → degrade to maybe)
# EVENT_LINKER_HARD_NEGATIVE_ENABLED=1            # set to 0 to disable all gates
# EVENT_LINKER_AUTO_MIN_ENTITY_JACCARD=0.05       # entity Jaccard below this → block auto-link
# EVENT_LINKER_MAYBE_MIN_ENTITY_JACCARD=0.01      # entity Jaccard below this → block maybe too (unless embed high)
# EVENT_LINKER_TOPIC_GATE_ENABLED=1               # set to 0 to disable topic mismatch gate
# EVENT_LINKER_TOPIC_TOP1_MUST_MATCH=1            # top1 topic must match for auto-link
# EVENT_LINKER_TITLE_GATE_ENABLED=1               # set to 0 to disable title contradiction gate
# EVENT_LINKER_TITLE_KEYWORD_JACCARD_MIN=0.06     # keyword Jaccard below this → block auto-link
# EVENT_LINKER_TITLE_ENTITY_JACCARD_MIN=0.01      # title entity Jaccard below this → block auto-link

# Event linker v2.1 — two-step linking (require multiple strong signals for auto-link)
# EVENT_LINKER_TWO_STEP_ENABLED=1                 # set to 0 to disable signal requirement
# EVENT_LINKER_AUTO_REQUIRES_SIGNALS=2            # min strong signals for auto-link (embed, entity, topic)
# EVENT_LINKER_SIGNAL_MIN_EMBED=0.45              # embedding cosine >= this counts as strong
# EVENT_LINKER_SIGNAL_MIN_ENTITY=0.08             # entity Jaccard >= this counts as strong
# EVENT_LINKER_SIGNAL_MIN_TOPIC=0.25              # topic sim >= this counts as strong

# Event linker v2.1 — split detector "airbag" (post-merge K=2 clustering)
# EVENT_LINKER_SPLIT_DETECTOR_ENABLED=1           # set to 0 to disable split detection
# EVENT_LINKER_SPLIT_MIN_ARTICLES=4               # min articles before checking for split
# EVENT_LINKER_SPLIT_CHECK_COOLDOWN_MIN=10        # minutes between split checks per event
# EVENT_LINKER_SPLIT_K=2                          # k-means cluster count
# EVENT_LINKER_SPLIT_MIN_SEPARATION=0.18          # min cosine distance between centroids
# EVENT_LINKER_SPLIT_MAX_WITHIN_COHESION=0.22     # min avg distance to overall centroid (mixed = high)

# Publish gate (feed eligibility filter)
# PUBLISH_GATE_ENABLED=0    # set to 0 to bypass the gate entirely
# GATE_MULTI_SOURCES=2      # min sources for multi-source gate
# GATE_MULTI_TEXT=1200       # min text length for multi-source gate
# GATE_SINGLE_TEXT=800       # min text length for single-source gate
# GATE_KEY_FACTS_MIN=0       # min key facts (default 0, set to 6 for strict mode)

# Per-media scrape timeout (ms)
# PER_MEDIA_TIMEOUT_MS=20000

# Quality metrics (GET /v1/debug/quality/snapshot)
# QUALITY_BOILERPLATE_ENABLED=1            # set to 0 to disable boilerplate detection
# QUALITY_MIXED_EVENT_ENABLED=1            # set to 0 to disable mixed-event (false merge) detection
# QUALITY_MIXED_EVENT_MAX_COHESION=0.3     # avg pairwise sim below this → mixed_event_flag
# QUALITY_SPLIT_PROXY_ENABLED=1            # set to 0 to disable split-proxy detection
# QUALITY_SPLIT_PROXY_MIN_SIM=0.75         # centroid sim above this → candidate split pair
# QUALITY_SPLIT_PROXY_MIN_ENTITY_OVERLAP=0.15  # entity Jaccard above this → confirm split pair

# Text sanitizer (pre-processing before embeddings, key facts, overview)
# TEXT_SANITIZER_ENABLED=1                     # set to 0 to disable all sanitization
# DEBUG_TEXT_SANITIZER=0                       # set to 1 for verbose sanitizer logs
# TEXT_SANITIZER_NUMERIC_DENSITY_THRESHOLD=0.35  # lines with digit ratio above this → removed
# TEXT_SANITIZER_MAX_NOISE_LINE_LEN=80         # max chars for nav/noise line detection
# TEXT_SANITIZER_DEDUP_ENABLED=1               # set to 0 to disable near-duplicate removal
# TEXT_SANITIZER_DEDUP_JACCARD=0.85            # Jaccard threshold for shingle dedup
# TEXT_SANITIZER_MIN_ALPHA_CHARS=12            # lines with fewer alpha chars → removed

# Bias safeguards
BIAS_MIN_CONFIDENCE=0.4
BIAS_MIN_EVIDENCE_REFS=1

# LLM (Semantic Intelligence v2) — optional, falls back to heuristic if unset
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
