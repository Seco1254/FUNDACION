# Required
DATABASE_URL=postgresql://fundacion:fundacion@localhost:5432/fundacion?schema=public

# Server
PORT=3000
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Cache
CACHE_MAX_ENTRIES=500
CACHE_DEFAULT_TTL_MS=30000

# Scheduler
SCHEDULER_TICK_MS=30000
SCRAPE_INTERVAL_MS=900000
PUBLISH_DELAY_MS=300000
CLOSE_CHECK_INTERVAL_MS=21600000
REFRESH_INTERVAL_MS=1800000

# Dev overrides (uncomment for faster local iteration)
# SCHEDULER_TICK_MS=5000
# PUBLISH_DELAY_MS=30000
# CLOSE_CHECK_INTERVAL_MS=60000
# REFRESH_INTERVAL_MS=60000

# Event linker thresholds (lower = more linking, fewer single-article events)
THETA_AUTO_LINK=0.45
THETA_MAYBE_LINK=0.30

# Event linker candidate window
EVENT_LINKER_CANDIDATE_WINDOW_HOURS=72
EVENT_LINKER_FALLBACK_WINDOW_DAYS=7

# Entity guard (prevents false merges when entities don't overlap)
# EVENT_LINKER_ENTITY_GUARD_ENABLED=0   # set to 0 to disable (enabled by default)
# EVENT_LINKER_ENTITY_GUARD_MIN_JACCARD=0.01

# Kill switches
# DISABLE_AUTO_LINK=1       # never auto-link, only maybe/create

# Debug / instrumentation (set to 1 for verbose linker decision logs)
# DEBUG_EVENT_LINKER=1

# Publish gate (feed eligibility filter)
# PUBLISH_GATE_ENABLED=0    # set to 0 to bypass the gate entirely
# GATE_MULTI_SOURCES=2      # min sources for multi-source gate
# GATE_MULTI_TEXT=1200       # min text length for multi-source gate
# GATE_SINGLE_TEXT=800       # min text length for single-source gate
# GATE_KEY_FACTS_MIN=0       # min key facts (default 0, set to 6 for strict mode)

# Per-media scrape timeout (ms)
# PER_MEDIA_TIMEOUT_MS=20000

# Bias safeguards
BIAS_MIN_CONFIDENCE=0.4
BIAS_MIN_EVIDENCE_REFS=1

# LLM (Semantic Intelligence v2) — optional, falls back to heuristic if unset
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_MODEL=claude-sonnet-4-5-20250929
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_MS=60000
