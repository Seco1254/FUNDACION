{
  "name": "fundacion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/check-env.js && node scripts/check-db.js && tsx watch src/server.ts",
    "dev:api": "PUBLISH_DELAY_MS=30000 tsx watch src/server.ts",
    "dev:client": "cd apps/client && npx expo start",
    "dev:all": "concurrently --names api,client --prefix-colors blue,green \"npm run dev:api\" \"npm run dev:client\"",
    "build": "tsc",
    "start": "node scripts/check-env.js && node scripts/check-dist.js && node scripts/check-db.js && node dist/server.js",
    "start:clean": "node scripts/clean-start.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:doctor": "node scripts/check-env.js && node scripts/check-db.js && node scripts/db-doctor.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx src/db/seeds/seed.ts",
    "db:seed:minimal": "tsx src/db/seeds/seed-media.ts",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "scrape:once": "tsx src/scripts/scrape-once.ts",
    "link:once": "tsx src/scripts/link-once.ts",
    "reset:db": "./bin/reset-db",
    "smoke": "./bin/smoke",
    "debug:ui": "./bin/debug-ui"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^6.3.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "fast-xml-parser": "^5.5.5",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "prisma": {
    "schema": "src/db/prisma/schema.prisma",
    "seed": "tsx src/db/seeds/seed.ts"
  }
}
